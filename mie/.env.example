# AVS Supabase - backend only. NEVER expose the service-role key in a browser/client.
SUPABASE_URL=https://mkkebukeajljuouecmce.supabase.co
# Preferred new backend key: sb_secret_...
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# Agno model string: provider:model_id
# Examples:
#   openai:gpt-5.5
#   google:gemini-3.5-flash
#   ollama:llama3.1:8b
MIE_MODEL=openai:gpt-5.5

# Add the credential required by the selected provider.
OPENAI_API_KEY=
GOOGLE_API_KEY=

MIE_DEFAULT_CAMPAIGN=CAMP-0001

# Internal Crawl4AI service.
# Generate a strong random value locally. Do not commit the real token.
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=

AGENTOS_DB_FILE=/data/agentos.db
AGNO_TELEMETRY=false
